{
  "name": "Filekit",
  "productName": "Filekit",
  "version": "1.0.1",
  "description": "A modern file management and analytics application",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package:win:arm64": "electron-forge package --platform=win32 --arch=arm64",
    "make:win:arm64": "electron-forge make --platform=win32 --arch=arm64",
    "publish:win:arm64": "electron-forge publish --platform=win32 --arch=arm64",
    "package:win:x64": "electron-forge package --platform=win32 --arch=x64",
    "make:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "publish:win:x64": "electron-forge publish --platform=win32 --arch=x64",
    "package:mac:x64": "electron-forge package --platform=darwin --arch=x64",
    "make:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "publish:mac:x64": "electron-forge publish --platform=darwin --arch=x64",
    "package:mac:arm64": "electron-forge package --platform=darwin --arch=arm64",
    "make:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "publish:mac:arm64": "electron-forge publish --platform=darwin --arch=arm64",
    "package:linux:x64": "electron-forge package --platform=linux --arch=x64",
    "make:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "publish:linux:x64": "electron-forge publish --platform=linux --arch=x64",
    "package:linux:arm64": "electron-forge package --platform=linux --arch=arm64",
    "make:linux:arm64": "electron-forge make --platform=linux --arch=arm64",
    "publish:linux:arm64": "electron-forge publish --platform=linux --arch=arm64",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "Er. P. Rohit V. Acharya",
    "email": "rohitpidishetty@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "babel-loader": "^10.1.1",
    "css-loader": "^6.11.0",
    "electron": "43.1.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "fs": "^0.0.1-security",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "recharts": "^3.9.2"
  }
}